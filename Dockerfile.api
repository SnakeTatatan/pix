FROM node:24-alpine

RUN apk add --no-cache python3 make g++ git

WORKDIR /app

COPY api/package.json api/package-lock.json* ./
COPY api/ ./

RUN npm install --production

# Désactiver le validateur d'env vars (conçu pour l'infra Scalingo de Pix)
RUN echo 'export default function validateEnvironmentVariables() { return; }' > src/shared/infrastructure/validate-environment-variables.js

# .env avec les valeurs par défaut pour les configs internes
RUN cat > .env << 'EOF'
NODE_ENV=production
AUTONOMOUS_COURSES_ORGANIZATION_ID=1
SCO_ACCOUNT_RECOVERY_KEY_LIFETIME_MINUTES=1440
FT_ALWAYS_OK_VALIDATE_NEXT_CHALLENGE_ENDPOINT=false
LCMS_API_KEY=not-used
LCMS_API_URL=https://lcms-api.pix.fr/api
DATAMART_DATABASE_URL=unused
PIX_AREA_REGEX_PATTERN=^[0-9]\.
PIX_AREA_PREFIX_FOR_FR_LOCALE=
TLD_FR=fr
TLD_ORG=org
DOMAIN_PIX_FR=https://pix.mathesciences.fr
DOMAIN_PIX_ORG=https://pix.mathesciences.fr
DOMAIN_PIX_APP=https://pix.mathesciences.fr
PIX_APP_DOMAIN=pix.mathesciences.fr
EOF

EXPOSE 3000

CMD ["npm", "start"]
